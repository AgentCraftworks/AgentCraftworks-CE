# AgentCraftworks Community Edition — Docker Configuration
# Copy this file to .env and customize as needed

# ─── Database Configuration ─────────────────────────────────────────────────
# WARNING: Change these defaults before using in production!
POSTGRES_USER=agentcraftworks
POSTGRES_PASSWORD=dev_password_change_in_prod
POSTGRES_DB=agentcraftworks

# ─── TypeScript API Configuration ───────────────────────────────────────────
DATABASE_URL=postgresql://agentcraftworks:dev_password_change_in_prod@postgres:5432/agentcraftworks
REDIS_URL=redis://redis:6379

# ─── GitHub App Configuration ───────────────────────────────────────────────
# Uncomment and configure with your GitHub App credentials
# GH_CE_APP_ID=your_app_id             # Community Edition GitHub App numeric ID
# GH_CE_APP_PRIVATE_KEY=your_pem_key   # Full PEM contents of the CE GitHub App private key
# GH_CE_WEBHOOK_SECRET=your_secret     # Webhook HMAC secret for the CE GitHub App

# ─── REST API Security ──────────────────────────────────────────────────────
# Bearer token required on /api/handoffs and /api/dial (Authorization: Bearer <token>).
# Generate with: openssl rand -hex 32
# Required except in explicit NODE_ENV=development/test; other modes return 503 until set.
# GH_CE_API_TOKEN=your_api_token
# Optional path to a JSON array of {name, sha256, scopes, repos}; hashes only, never raw tokens.
# GH_CE_API_TOKENS_FILE=
# Per-IP request limit per minute for /api/handoffs and /api/dial (default: 60)
# API_RATE_LIMIT=60
# Trusted ingress proxy IPs/CIDRs, comma-separated; unset ignores forwarded headers.
# Set only to verified ingress addresses; never use true, hop counts, or all-address ranges.
# GH_CE_TRUST_PROXY=
